<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue"

    >
    <ImageView
        android:id="@+id/forgot_back"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="25dp"
        app:tint="@color/white"
        android:src="@drawable/ic_back"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:clickable="true"
        android:onClick="Func"

        />

    <ImageView
        android:id="@+id/forgot_globe"
        android:layout_width="40dp"
        android:layout_height="40dp"

        android:src="@drawable/ic_globe"
        android:layout_marginTop="20dp"
        android:tint="@color/white"

        app:layout_constraintBottom_toTopOf="@+id/white_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ScrollView
        android:id="@+id/white_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/white_card_rounded"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/forgot_globe"
        app:layout_constraintVertical_bias="1.0"

        >


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="30dp"
            android:orientation="vertical"

            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset Your Password"
                android:textColor="@color/black"
                android:layout_marginTop="10dp"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter your email address and we'll send you instructions to reset your password."
                android:textColor="@color/black"
                android:layout_marginTop="10dp"
                android:textSize="16sp"

                />


            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"

                >


                <TextView
                    android:id="@+id/forgot_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_alignParentStart="true"
                    android:layout_marginTop="20dp"
                    android:text="Email Address"
                    android:textColor="@color/black"
                    android:textSize="14sp" />


                <EditText
                    android:id="@+id/forgot_editmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/forgot_email"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="5dp"
                    android:drawableStart="@drawable/ic_mail"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/black"
                    android:hint="Enter Your Email"
                    android:inputType="textEmailAddress" />





            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"


                >
            <com.google.android.material.button.MaterialButton
                android:id="@+id/forgot_BTN"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:onClick="Func"
                android:text="Send Reset Instructions"
                android:textColor="@color/white"
                app:cornerRadius="5dp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent" />










                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="Func"
                    android:layout_marginTop="10dp"
                    android:text="Back to Login"
                    android:textStyle="bold"
                    android:textColor="@color/blue" />
            </LinearLayout>
        </LinearLayout>


    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>