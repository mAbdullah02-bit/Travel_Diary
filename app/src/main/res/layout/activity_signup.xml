<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue"

    >
    <ImageView
        android:id="@+id/signup_back"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="25dp"
        android:tint="@color/white"
        android:src="@drawable/ic_back"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:clickable="true"
        android:onClick="Func"

        />

    <ImageView
        android:id="@+id/signup_globe"
        android:layout_width="40dp"
        android:layout_height="40dp"

        android:src="@drawable/ic_globe"
        android:layout_marginTop="20dp"
        android:tint="@color/white"

        app:layout_constraintBottom_toTopOf="@+id/white_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ScrollView
        android:id="@+id/white_card"
        android:layout_width="match_parent"

        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/white_card_rounded"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signup_globe"
        app:layout_constraintVertical_bias="1.0"

       >


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="30dp"
            android:orientation="vertical"

            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Join Travel Journal"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start capturing your travel memories today"
                android:textColor="@color/black"
                android:textSize="16sp"

                />


            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"

                >

                <TextView
                    android:id="@+id/signup_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="10dp"
                    android:text="Full Name"

                    android:textColor="@color/black"
                    android:textSize="14sp" />


                <EditText
                    android:id="@+id/signup_editname"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/signup_name"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="5dp"
                    android:drawableStart="@drawable/ic_person"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/black"
                    android:hint="Enter Your Name"
                    android:inputType="textEmailAddress" />


                <TextView
                    android:id="@+id/signup_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/signup_editname"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="10dp"
                    android:text="Email Address"
                    android:textColor="@color/black"
                    android:textSize="14sp" />


                <EditText
                    android:id="@+id/signup_editmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/signup_email"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="5dp"
                    android:drawableStart="@drawable/ic_mail"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/black"
                    android:hint="Enter Your Email"
                    android:inputType="textEmailAddress" />

                <TextView
                    android:id="@+id/signup_pass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/signup_editmail"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="10dp"
                    android:text="Password"
                    android:textColor="@color/black"
                    android:textSize="14sp"


                    />


                <EditText
                    android:id="@+id/signup_editpass"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/signup_pass"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="5dp"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/black"
                    android:hint="Enter Your Password"
                    android:inputType="textPassword"

                    />

                <TextView
                    android:id="@+id/signup_passC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/signup_editpass"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="10dp"
                    android:text="Confirm Password"
                    android:textColor="@color/black"
                    android:textSize="14sp"


                    />


                <EditText
                    android:id="@+id/signup_editpassC"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/signup_passC"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="5dp"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/black"
                    android:hint="Confirm Your Password"
                    android:inputType="textPassword"

                    />


                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/signup_agree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_below="@+id/signup_editpassC"
                    android:layout_alignParentStart="true"
                    android:text="Agree to our terms and Conditions"
                    android:textColor="@color/gray"
                    android:textSize="16sp" />


            </RelativeLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signup_BTN"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="Func"
                android:text="Create Account"
                android:textColor="@color/white"
                app:cornerRadius="5dp"
                app:layout_constraintBottom_toBottomOf="parent" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"

                >

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:background="@color/gray" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="5dp"
                    android:text="OR SIGNUP WITH" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:background="@color/gray" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/signup_fbBTN"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:onClick="Func"
                    android:text="Facebook"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/signup_goBTN"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:onClick="Func"
                    android:text="Google"
                    app:cornerRadius="10dp"

                    />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_margin="10dp"

                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? "

                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="Func"
                    android:text="Login In"
                    android:textColor="@color/blue" />
            </LinearLayout>
        </LinearLayout>


    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>