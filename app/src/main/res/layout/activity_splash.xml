<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    >

    <View
        android:id="@+id/splash_image"
        android:layout_width="203dp"
        android:layout_height="196dp"
        android:background="@drawable/bg_rounded_gray"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.119" />

    <ImageView
        android:id="@+id/floatingBlueButton"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:padding="1dp"
        android:src="@drawable/icplus"
        app:layout_constraintBottom_toBottomOf="@+id/splash_image"
        app:layout_constraintEnd_toEndOf="@+id/splash_image"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:layout_marginTop="32dp"
        android:fontFamily="sans-serif-condensed-medium"
        android:text="@string/splash_title"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/splash_image" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/black"
        android:fontFamily="sans-serif-condensed-medium"
        android:lineSpacingExtra="4sp"
        android:paddingHorizontal="32dp"
        android:text="@string/splash_desc"
        android:textAlignment="center"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/splash_title" />

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.23"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView2">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            >

            <View
                android:id="@+id/ic_home"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_alignParentStart="true"
                android:background="@drawable/splash_home" />

            <TextView
                android:id="@+id/t1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-1dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="148dp"
                android:layout_toEndOf="@id/ic_home"
                android:fontFamily="sans-serif-condensed-medium"
                android:text="Photo Gallery"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/t2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/t1"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:layout_toRightOf="@id/ic_home"
                android:fontFamily="sans-serif-condensed-medium"
                android:maxLines="1"
                android:text="Store all your travel photos in one place"
                android:textAlignment="center"
                 />
        </RelativeLayout>

        <RelativeLayout
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/ic_loc"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_alignParentStart="true"
                android:background="@drawable/splash_location" />

            <TextView
                android:id="@+id/t3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="148dp"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:layout_toEndOf="@id/ic_loc"
                android:fontFamily="sans-serif-condensed-medium"
                android:text="Track Locations"
                android:textAlignment="center"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/t4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/t3"
                android:layout_toRightOf="@id/ic_loc"
                android:fontFamily="sans-serif-condensed-medium"
                android:maxLines="1"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:text="Save and remember all the places you visit"
                android:textAlignment="center"
            />
        </RelativeLayout>

        <RelativeLayout
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/ic_sec"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_alignParentStart="true"
                android:background="@drawable/splash_secure" />

            <TextView
                android:id="@+id/t5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="148dp"
                android:textSize="18sp"
                android:layout_toEndOf="@id/ic_sec"
                android:fontFamily="sans-serif-condensed-medium"
                android:text="Secure Timeline"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/t6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/t5"
                android:layout_toRightOf="@id/ic_sec"
                android:fontFamily="sans-serif-condensed-medium"
                android:maxLines="1"
                android:text="Organize trips and activities securely"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="15sp" />
        </RelativeLayout>


    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_splash"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"

        android:fontFamily="sans-serif-condensed-medium"
        android:text="Get Started"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:backgroundTint="@color/blue"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_guest"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_guest"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:fontFamily="sans-serif-condensed-medium"
        android:text="Be A guest"
        android:textColor="@color/blue"
        android:textStyle="bold"
        app:backgroundTint="@color/white"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/gray"
        app:strokeWidth="2dp" />


</androidx.constraintlayout.widget.ConstraintLayout>